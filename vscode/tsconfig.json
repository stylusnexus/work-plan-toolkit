{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    // module is es2022 (not commonjs) only so tsc accepts `import.meta` in the
    // test files, which tsc now typechecks (#530). esbuild ignores this field
    // (it bundles to cjs itself) and tsc never emits, so output is unchanged.
    // Build is done by esbuild and tests run via Node's --experimental-strip-types,
    // which resolves .ts import specifiers directly. tsc is typecheck-only (noEmit),
    // which is what allows allowImportingTsExtensions. Do not expect tsc to emit JS.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
